APP_NAME=FarmOS
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate --show
APP_KEY=
APP_URL=https://farm.example.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=farmos
DB_USERNAME=farmos
DB_PASSWORD=change-me

# Redis carries cache, locks (milk stock, idempotency), queues and sessions.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=farmos
REVERB_APP_KEY=change-me-public-key
REVERB_APP_SECRET=change-me-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Single-farm server: no public sign-up. Create the owner with `php artisan farmos:create-owner`.
FARMOS_REGISTRATION=false

# Personal-access-token lifetime in minutes (30 days).
SANCTUM_TOKEN_EXPIRATION=43200

FILESYSTEM_DISK=local
